{
  "name": "Cliente",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string"
    },
    "telefone": {
      "type": "string"
    },
    "data_nascimento": {
      "type": "string",
      "format": "date"
    },
    "observacoes": {
      "type": "string"
    },
    "promocoes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string",
            "enum": [
              "brinde",
              "promocao"
            ]
          },
          "descricao": {
            "type": "string"
          },
          "data": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "tipo",
          "data"
        ]
      }
    },
    "demo": {
      "type": "boolean",
      "default": false
    },
    "consentimento_aniversario": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
